{
  "ci": {
    "collect": {
      "staticDistDir": "./public",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/atividades.html",
        "http://localhost/mundo-digital.html",
        "http://localhost/cultura-digital.html",
        "http://localhost/404.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:best-practices": ["warn", { "minScore": 0.90 }],
        "categories:seo": ["warn", { "minScore": 0.90 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "interactive": ["warn", { "maxNumericValue": 4000 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.15 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 350000 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 1200000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
