{
  "name": "lms-bncc-computacao",
  "version": "1.0.0",
  "description": "LMS (Learning Management System) para ensino da BNCC Computação",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/database/seed.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:db:local": "wrangler d1 execute lms_prod --local --file=./d1/schema.sql",
    "cf:db:remote": "wrangler d1 execute lms_prod --remote --file=./d1/schema.sql",
    "cf:seed:local": "wrangler d1 execute lms_prod --local --file=./d1/seed.sql",
    "cf:seed:remote": "wrangler d1 execute lms_prod --remote --file=./d1/seed.sql"
  },
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.0",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "wrangler": "^4.19.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
