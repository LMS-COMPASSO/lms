{
  "name": "lms-bncc-computacao",
  "version": "1.0.0",
  "description": "LMS (Learning Management System) para ensino da BNCC Computação no Cloudflare Workers e D1",
  "type": "module",
  "main": "src/worker/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:db:local": "wrangler d1 execute lms_prod --local --file=./d1/schema.sql",
    "cf:db:remote": "wrangler d1 execute lms_prod --remote --file=./d1/schema.sql",
    "cf:seed:local": "wrangler d1 execute lms_prod --local --file=./d1/seed.sql",
    "cf:seed:remote": "wrangler d1 execute lms_prod --remote --file=./d1/seed.sql",
    "gerar:pdf": "bash scripts/gerar-compartilhamento.sh --pdf",
    "gerar:png": "bash scripts/gerar-compartilhamento.sh --png",
    "gerar:logos": "bash scripts/gerar-logos-png.sh",
    "gerar:todos": "bash scripts/gerar-compartilhamento.sh && bash scripts/gerar-logos-png.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "shadcn": "^4.21.5",
    "wrangler": "^4.19.0"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
