{
  "name": "lms-bncc-computacao",
  "version": "1.0.0",
  "description": "LMS (Learning Management System) para ensino da BNCC Computação no Cloudflare Workers e D1",
  "type": "module",
  "main": "src/worker/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "find public/js src/worker tests -name '*.js' | while read -r f; do node --check \"$f\" || exit 1; done",
    "test": "node --test",
    "test:unit": "node --test",
    "test:python": "python3 tests/python/test_atividades_3d.py",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/acessibilidade-axe.spec.js",
    "test:visual": "playwright test tests/e2e/regressao-visual.spec.js",
    "test:all": "npm test && npm run test:python && npm run test:e2e",
    "validate:data": "node scripts/validar-schemas.js",
    "validate:schemas": "node scripts/validar-schemas.js",
    "lighthouse": "lhci autorun --config=.lighthouserc.json",
    "quality": "bash scripts/validar-qa-local.sh",
    "qa": "bash scripts/validar-qa-local.sh",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:db:local": "wrangler d1 execute lms_prod --local --file=./d1/schema.sql",
    "cf:db:remote": "wrangler d1 execute lms_prod --remote --file=./d1/schema.sql",
    "cf:seed:local": "wrangler d1 execute lms_prod --local --file=./d1/seed.sql",
    "cf:seed:remote": "wrangler d1 execute lms_prod --remote --file=./d1/seed.sql",
    "gerar:pdf": "bash scripts/gerar-compartilhamento.sh --pdf",
    "gerar:png": "bash scripts/gerar-compartilhamento.sh --png",
    "gerar:logos": "bash scripts/gerar-logos-png.sh",
    "gerar:todos": "bash scripts/gerar-compartilhamento.sh && bash scripts/gerar-logos-png.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "shadcn": "^4.22.1",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
